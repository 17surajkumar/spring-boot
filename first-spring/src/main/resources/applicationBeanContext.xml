<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <!-- we give the instruction to spring IOC to manages the object of this Greeting service class-->
    <bean id="myBean" class="com.example.demo.GreetingService"/>


    <bean id="EmailNotificationService" class="com.example.loose.EmailNotificationService"/>
    <bean id="SMSNotificationService" class="com.example.loose.SMSNotificationService"/>

    <bean id="UserServiceEmail" class="com.example.loose.UserService">
        <property name="notificationService" ref="EmailNotificationService"/>
    </bean>

    <bean id="UserServiceSMS" class="com.example.loose.UserService">
    <!--here using the property the setter method is called thru UserService-->
<!--        <property name="notificationService" ref="SMSNotificationService"/>-->
        <constructor-arg ref="SMSNotificationService"/>
    </bean>


</beans>